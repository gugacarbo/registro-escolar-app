#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Uso: bun run db:migrate -- --name=<nome-descritivo>"
  echo "Exemplo: bun run db:migrate -- --name=cria-tabela-usuarios"
  exit 1
}

NAME=""
for arg in "$@"; do
  case "$arg" in
    --name=*)
      NAME="${arg#*=}"
      ;;
    --name)
      shift
      NAME="${1:-}"
      ;;
  esac
done

if [[ -z "$NAME" ]]; then
  echo "Erro: a migration deve ser explicitamente nomeada com --name." >&2
  usage
fi

if [[ "$NAME" =~ ^[0-9]{4}_[a-z_]+$ ]]; then
  : # ok
else
  echo "Aviso: prefira nomes descritivos em snake_case, ex: cria_tabela_usuarios" >&2
fi

exec drizzle-kit migrate "$@"
