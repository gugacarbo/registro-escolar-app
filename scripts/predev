#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

# Cores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[predev]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[predev]${NC} $*"; }
log_error() { echo -e "${RED}[predev]${NC} $*"; }
log_success() { echo -e "${GREEN}[predev]${NC} $*"; }

# 1. Verifica dependências do ambiente
check_command() {
  local cmd=$1
  local install_hint=$2
  if ! command -v "$cmd" &>/dev/null; then
    log_error "Dependência obrigatória não encontrada: $cmd"
    log_info "Instale com: $install_hint"
    exit 1
  fi
}

log_info "Verificando dependências do ambiente..."

check_command "bun" "curl -fsSL https://bun.sh/install | bash"
check_command "node" "https://nodejs.org/"
check_command "wrangler" "bun add -g wrangler   # ou: npm install -g wrangler"

if ! command -v "cloudflared" &>/dev/null; then
  log_warn "cloudflared não encontrado. Só é necessário para túneis externos; dev local funciona sem."
fi

# 2. Gera BETTER_AUTH_SECRET seguro (hex evita caracteres especiais no sed)
generate_secret() {
  if command -v openssl &>/dev/null; then
    openssl rand -hex 32
  else
    log_warn "openssl não encontrado, tentando gerar secret via better-auth CLI..."
    bunx @better-auth/cli secret 2>/dev/null || {
      log_error "Não foi possível gerar BETTER_AUTH_SECRET automaticamente."
      log_info "Gere manualmente com: bunx @better-auth/cli secret"
      exit 1
    }
  fi
}

ensure_secret() {
  local file=$1
  local secret

  if [ ! -f "$file" ]; then
    return 0
  fi

  # Se BETTER_AUTH_SECRET não existir ou estiver vazia, gera uma nova
  if ! grep -qE '^BETTER_AUTH_SECRET=[^[:space:]]+' "$file"; then
    secret=$(generate_secret)
    if grep -qE '^BETTER_AUTH_SECRET=' "$file"; then
      sed -i.bak -E "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$secret|" "$file"
      rm -f "$file.bak"
    else
      echo "BETTER_AUTH_SECRET=$secret" >> "$file"
    fi
    log_success "BETTER_AUTH_SECRET gerada e salva em $file"
  fi
}

# 3. Cria .env.local a partir do .env.example se não existir
if [ ! -f ".env.local" ]; then
  log_info ".env.local não encontrado. Criando a partir de .env.example..."
  cp ".env.example" ".env.local"
fi
ensure_secret ".env.local"

# 4. Cria .dev.vars a partir do .dev.vars.example se não existir
if [ ! -f ".dev.vars" ]; then
  log_info ".dev.vars não encontrado. Criando a partir de .dev.vars.example..."
  cp ".dev.vars.example" ".dev.vars"
fi
ensure_secret ".dev.vars"

# 5. Sincroniza BETTER_AUTH_SECRET entre .env.local e .dev.vars
sync_secret() {
  local local_secret dev_secret

  if [ ! -f ".env.local" ] || [ ! -f ".dev.vars" ]; then
    return 0
  fi

  local_secret=$(grep -E '^BETTER_AUTH_SECRET=' ".env.local" | head -1 | cut -d= -f2-)
  dev_secret=$(grep -E '^BETTER_AUTH_SECRET=' ".dev.vars" | head -1 | cut -d= -f2-)

  if [ -z "$local_secret" ] || [ -z "$dev_secret" ]; then
    return 0
  fi

  if [ "$local_secret" != "$dev_secret" ]; then
    log_warn "BETTER_AUTH_SECRET difere entre .env.local e .dev.vars. Sincronizando..."
    sed -i.bak -E "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$local_secret|" ".dev.vars"
    rm -f ".dev.vars.bak"
    log_success "BETTER_AUTH_SECRET sincronizada em .dev.vars"
  fi
}

sync_secret

# 6. Verifica banco D1 local e aplica migrations
log_info "Verificando banco D1 local..."

MIGRATIONS_DIR="./drizzle"
DB_NAME="registro-escolar-db"

if [ ! -d "$MIGRATIONS_DIR" ] || [ -z "$(ls -A "$MIGRATIONS_DIR" 2>/dev/null)" ]; then
  log_warn "Diretório de migrations '$MIGRATIONS_DIR' vazio ou inexistente."
  log_info "Se o schema mudou, gere as migrations com: bun run db:generate"
else
  log_info "Aplicando migrations locais em $DB_NAME..."
  if bun run db:local:migrate; then
    log_success "Migrations locais aplicadas."
  else
    log_error "Falha ao aplicar migrations locais."
    log_info "Dica: apague .wrangler/state/v3/d1 para resetar o banco local."
    exit 1
  fi
fi

log_success "Ambiente de dev pronto. Rode 'bun run dev' para iniciar."
