{
	"name": "registro-escolar-app",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"predev": "scripts/pre-dev",
		"dev": "vite dev --port 3001 --host",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "bun run build && vite preview",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "bun x vitest run",
		"test:watch": "bun x vitest",
		"test:coverage": "bun x vitest run --coverage",
		"e2e": "playwright test --grep-invert @visual",
		"e2e:ui": "playwright test --ui",
		"test:visual": "playwright test --grep @visual",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "bun run build && wrangler deploy",
		"db:generate": "scripts/db-generate",
		"db:migrate": "scripts/db-migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"spellcheck": "cspell lint \"**/*\"",
		"format:prettier": "prettier --write \"**/*.{md,sh,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{md,sh,yml,yaml}\"",
		"secrets:check": "gitleaks detect --source . --verbose --config .gitleaks.toml",
		"cf-typegen": "wrangler types",
		"db:local:migrate": "wrangler d1 migrations apply registro-escolar-db --local",
		"db:seed": "bun scripts/db-seed.ts",
		"db:remote:migrate": "wrangler d1 migrations apply registro-escolar-db --remote",
		"db:create": "wrangler d1 create registro-escolar-db",
		"pre-push": "bun run secrets:check && bun run check && bun run typecheck && bun run test && bun run build && bun run spellcheck && scripts/docs-check",
		"e2e:setup": "scripts/e2e-setup"
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "latest",
		"better-auth": "^1.5.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"lucide-react": "^0.577.0",
		"next-themes": "^0.4.6",
		"papaparse": "^5.7.0",
		"pdf-lib": "^1.17.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.87.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tslib": "2.8.1",
		"tw-animate-css": "^1.3.6",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@cspell/dict-pt-br": "^2.4.2",
		"@cspell/dict-pt-pt": "^3.0.6",
		"@faker-js/faker": "^10.3.0",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-event-client": "latest",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "latest",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^22.20.1",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^3.2.4",
		"better-sqlite3": "^13.0.3",
		"cspell": "^10.3.0",
		"dotenv": "^17.3.1",
		"drizzle-kit": "^0.31.9",
		"gitleaks": "^1.0.0",
		"happy-dom": "^20.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"simple-git-hooks": "^2.14.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^3.2.4",
		"wrangler": "^4.129.1"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"esbuild",
		"lightningcss",
		"sharp",
		"workerd"
	]
}
