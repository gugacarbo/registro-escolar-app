/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "registro-escolar-app",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/default-entry.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "registro-escolar-app-db",
			"database_id": "bf289dfc-d273-4456-b664-7c5ce7ed6d9c",
			"migrations_dir": "./drizzle"
		}
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"BETTER_AUTH_URL": "https://registro-escolar-app.gugacarbo.workers.dev",
		"BETTER_AUTH_TRUSTED_ORIGINS": "https://registro-escolar-app.gugacarbo.workers.dev"
	}
}
