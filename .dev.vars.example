# Cloudflare credentials (only needed for drizzle-kit against remote D1)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
# Origens extras confiáveis separadas por vírgula (além de BETTER_AUTH_URL e localhost/127.0.0.1:3001, sempre incluídos)
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional public app title (client-side)
VITE_APP_TITLE="Registro Escolar"

RESEND_API_KEY=re_
# Remetente dos e-mails enviados pelo Resend
EMAIL_FROM="Registro Escolar <onboarding@resend.dev>"

# Database seeding (small | medium | large; opcional, padrão: medium)
SEED_SCALE=medium

# E2E/test tooling (opcionais; os comandos usam os valores padrão)
E2E_BASE_URL=http://localhost:3001
E2E_PERSIST_STATE=.wrangler/state/e2e
