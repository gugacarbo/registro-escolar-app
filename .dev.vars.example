# Cloudflare credentials (only needed for drizzle-kit against remote D1)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
# Origens extras confiáveis separadas por vírgula (além de BETTER_AUTH_URL e localhost/127.0.0.1:3001, sempre incluídos)
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional public app title (client-side)
VITE_APP_TITLE="Registro Escolar"
